# Affari Member API. Server-side only — never expose with a NEXT_PUBLIC_ prefix.
# Leave AFFARI_TOKEN empty to run the app against the built-in sample member.
AFFARI_TOKEN=
AFFARI_BASE_URL=https://api.affariretail.id/beauty/
AFFARI_TIMEOUT_MS=12000

# `field` values /api/member is searched by, in order, when a member logs in.
# Confirm the real field name for phone number before going live.
AFFARI_LOGIN_FIELDS=kode,nohp

# Signs the session cookie. At least 32 characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
